# Django Settings
SECRET_KEY=your-secret-key-here-generate-new-one-for-production
DEBUG=False
# Multi-tenant: cada óptica se resuelve por subdominio, así que ALLOWED_HOSTS
# y CSRF_TRUSTED_ORIGINS suelen usar el wildcard (el punto/asterisco inicial
# cubre cualquier subdominio). No hace falta una variable por cada óptica: el
# alias de conexión de cada una se arma reusando este mismo DATABASE_URL.
ALLOWED_HOSTS=localhost,127.0.0.1,.tu-dominio.com

# Database — es la base de CONTROL (registro de ópticas). Cada óptica tiene
# su propia base aparte, creada con "python manage.py crear_optica".
# (leave empty to use SQLite locally)
DATABASE_URL=

# Security in Production
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://*.tu-dominio.com

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
